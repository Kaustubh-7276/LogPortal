/*==========================================================
    SocketClient.js
    Enterprise Socket Client
    ASP.NET MVC (.NET Framework 4.8)
==========================================================*/

var SocketClient = {

    timer: null,

    controls: {},

    state: {

        connected: false,

        txCount: 0,

        rxCount: 0,

        lastResponse: "",

        polling: false

    },

    cacheControls: function () {

        this.controls.server = $("#txtServer");
        this.controls.port = $("#txtPort");

        this.controls.request = $("#txtRequest");
        this.controls.response = $("#txtResponse");

        this.controls.status = $("#lblStatus");
        this.controls.connection = $("#txtConnectionStatus");

        this.controls.tx = $("#lblTxCount");
        this.controls.rx = $("#lblRxCount");

        this.controls.activity = $("#lblLastActivity");

        this.controls.connect = $("#btnConnect");
        this.controls.disconnect = $("#btnDisconnect");
        this.controls.send = $("#btnSend");

        this.controls.clear = $("#btnClear");

        this.controls.copyTx = $("#btnCopyTx");
        this.controls.copyRx = $("#btnCopyRx");

        this.controls.clearTx = $("#btnClearTx");
        this.controls.clearRx = $("#btnClearRx");

        this.controls.exportHistory = $("#btnExport");
        this.controls.clearHistory = $("#btnClearHistory");

        this.controls.history = $("#tblHistory tbody");
        this.controls.logs = $("#tblLogs tbody");

        this.controls.search = $("#txtSearchLog");

        this.controls.loading = $("#loadingPanel");

        this.controls.toast = $("#copyToast");

    },

    init: function () {

        this.cacheControls();

        this.registerEvents();

        this.initializeScreen();


    },

    registerEvents: function () {

        var self = this;

        self.controls.connect.on("click", function () {

            self.connect();

        });

        self.controls.disconnect.on("click", function () {

            self.disconnect();

        });

        self.controls.send.on("click", function () {

            self.send();

        });

        self.controls.clear.on("click", function () {

            self.initializeScreen();

        });

        self.controls.clearTx.on("click", function () {

            self.controls.request.val("");

        });

        self.controls.clearRx.on("click", function () {

            self.controls.response.val("");

        });

        self.controls.copyTx.on("click", function () {

            self.copy(self.controls.request);

        });

        self.controls.copyRx.on("click", function () {

            self.copy(self.controls.response);

        });

        self.controls.exportHistory.on("click", function () {

            self.exportHistory();

        });

        self.controls.clearHistory.on("click", function () {

            self.clearHistory();

        });

        self.controls.search.on("keyup", function () {

            self.searchLogs($(this).val());

        });

    },

    initializeScreen: function () {

        this.state.connected = false;

        this.state.txCount = 0;

        this.state.rxCount = 0;

        this.state.lastResponse = "";

        this.controls.request.val("");

        this.controls.response.val("");

        this.controls.tx.text("0");

        this.controls.rx.text("0");

        this.controls.activity.text("--");

        this.controls.history.empty();

        this.controls.logs.empty();

        this.setConnection(false);

    },

    setConnection: function (connected) {

        this.state.connected = connected;

        if (connected) {

            this.controls.status
                .removeClass("text-danger")
                .addClass("text-success")
                .text("Connected");

            this.controls.connection.val("Connected");

            this.controls.server.prop("disabled", true);

            this.controls.port.prop("disabled", true);

            this.controls.connect.prop("disabled", true);

            this.controls.disconnect.prop("disabled", false);

            this.controls.send.prop("disabled", false);

        }
        else {

            this.controls.status
                .removeClass("text-success")
                .addClass("text-danger")
                .text("Disconnected");

            this.controls.connection.val("Disconnected");

            this.controls.server.prop("disabled", false);

            this.controls.port.prop("disabled", false);

            this.controls.connect.prop("disabled", false);

            this.controls.disconnect.prop("disabled", true);

            this.controls.send.prop("disabled", true);

        }

    },
    connect: function () {

        var self = this;

        if ($.trim(self.controls.server.val()) === "") {

            self.showToast("Please enter Server IP.");

            self.controls.server.focus();

            return;
        }

        if ($.trim(self.controls.port.val()) === "") {

            self.showToast("Please enter Port.");

            self.controls.port.focus();

            return;
        }

        self.showLoading();

        $.ajax({

            url: "/SocketClient/Connect",

            type: "POST",

            dataType: "json",

            data: {

                HostAddress: self.controls.server.val(),

                HostPort: parseInt(self.controls.port.val())

            },

            xhrFields: {
                withCredentials: true
            },

            success: function (result) {

                self.hideLoading();

                if (!result.Success) {

                    self.showToast(result.SuccessMessage);

                    self.setConnection(false);

                    return;
                }

                self.setConnection(true);

                self.controls.activity.text(result.TimeStamp);

                self.startPolling();

                self.showToast(result.SuccessMessage);

            },

            error: function (xhr) {

                self.hideLoading();

                self.setConnection(false);

                self.showToast("Unable to connect.");

                console.log(xhr);

            }

        });

    },

    disconnect: function () {

        var self = this;

        if (!self.state.connected) {

            self.showToast("Already disconnected.");

            return;
        }

        self.showLoading();

        $.ajax({

            url: "/SocketClient/Disconnect",

            type: "POST",

            dataType: "json",

            xhrFields: {
                withCredentials: true
            },

            success: function (result) {

                self.hideLoading();

                self.stopPolling();

                self.initializeScreen();

                self.showToast(result.SuccessMessage);

            },

            error: function (xhr) {

                self.hideLoading();

                self.showToast("Disconnect failed.");

                console.log(xhr);

            }

        });

    },

    showLoading: function () {

        this.controls.loading.stop(true, true).fadeIn(150);

    },

    hideLoading: function () {

        this.controls.loading.stop(true, true).fadeOut(150);

    },

    showToast: function (message) {

        this.controls.toast.find("span").html(

            "<i class='fa fa-check-circle'></i> " + message

        );

        this.controls.toast
            .stop(true, true)
            .fadeIn(250)
            .delay(1800)
            .fadeOut(250);

    },
    send: function () {

        var self = this;

        if (!self.state.connected) {

            self.showToast("Please connect to server first.");

            return;
        }

        var request = $.trim(self.controls.request.val());

        if (request === "") {

            self.showToast("Please enter request message.");

            self.controls.request.focus();

            return;
        }

        self.showLoading();

        $.ajax({

            url: "/SocketClient/Send",

            type: "POST",

            dataType: "json",

            data: {

                HostMessage: request

            },

            xhrFields: {
                withCredentials: true
            },

            success: function (result) {

                self.hideLoading();

                if (!result.Success) {

                    self.showToast(result.SuccessMessage);

                    return;
                }

                self.state.txCount++;

                self.controls.tx.text(self.state.txCount);

                self.controls.activity.text(result.TimeStamp);

                self.addHistory(
                    "TX",
                    request,
                    result.TimeStamp);

                self.addLog(
                    "Request",
                    request,
                    result.TimeStamp);

                self.autoScroll();

                self.showToast(result.SuccessMessage);

            },

            error: function (xhr) {

                self.hideLoading();

                self.showToast("Communication Error.");

                console.log(xhr);

            }

        });

    },

    startPolling: function () {

        var self = this;

        if (self.state.polling)
            return;

        self.state.polling = true;

        self.timer = window.setInterval(function () {

            self.getLatestResponse();

        }, 500);

    },

    stopPolling: function () {

        if (this.timer != null) {

            clearInterval(this.timer);

            this.timer = null;

        }

        this.state.polling = false;

    },

    getLatestResponse: function () {

        var self = this;

        if (!self.state.connected)
            return;

        $.ajax({

            url: "/SocketClient/GetLatestResponse",

            type: "GET",

            dataType: "json",

            xhrFields: {
                withCredentials: true
            },

            success: function (result) {

                if (!result.Success)
                    return;

                if (!result.ResponseData)
                    return;

                if (result.ResponseData === self.state.lastResponse)
                    return;

                self.state.lastResponse = result.ResponseData;

                self.state.rxCount++;

                self.controls.rx.text(self.state.rxCount);

                self.controls.response.val(result.ResponseData);

                self.controls.activity.text(result.TimeStamp);

                self.addHistory(
                    "RX",
                    result.ResponseData,
                    result.TimeStamp);

                self.addLog(
                    "Response",
                    result.ResponseData,
                    result.TimeStamp);

                self.autoScroll();

            },

            error: function (xhr) {

                console.log(xhr);

            }

        });

    },
    addHistory: function (direction, message, timeStamp) {

        var row = "";

        row += "<tr>";

        row += "<td>" + (this.controls.history.find("tr").length + 1) + "</td>";

        row += "<td>" + (timeStamp || "--") + "</td>";

        row += "<td>" + direction + "</td>";

        row += "<td>" + (direction === "TX" ? "Sent" : "Received") + "</td>";

        row += "<td>" + this.htmlEncode(message) + "</td>";

        row += "<td>" + message.length + "</td>";

        row += "</tr>";

        this.controls.history.append(row);

    },

    addLog: function (type, message, timeStamp) {

        var row = "";

        row += "<tr>";

        row += "<td>" + (this.controls.logs.find("tr").length + 1) + "</td>";

        row += "<td>" + (timeStamp || "--") + "</td>";

        row += "<td>" + type + "</td>";

        row += "<td>Completed</td>";

        row += "<td>" + this.htmlEncode(message) + "</td>";

        row += "</tr>";

        this.controls.logs.append(row);

    },

    copy: function (control) {

        var self = this;

        if (!control || control.length === 0)
            return;

        navigator.clipboard.writeText(control.val())
            .then(function () {

                self.showToast("Copied Successfully");

            })
            .catch(function () {

                self.showToast("Copy Failed");

            });

    },

    clearHistory: function () {

        this.controls.history.empty();

        this.controls.logs.empty();

        this.state.txCount = 0;

        this.state.rxCount = 0;

        this.state.lastResponse = "";

        this.controls.tx.text("0");

        this.controls.rx.text("0");

        this.showToast("History Cleared");

    },

    searchLogs: function (text) {

        text = $.trim(text).toLowerCase();

        this.controls.logs.find("tr").each(function () {

            var row = $(this);

            row.toggle(row.text().toLowerCase().indexOf(text) > -1);

        });

    },

    exportHistory: function () {

        var csv = [];

        $("#tblHistory tr").each(function () {

            var row = [];

            $(this).find("th,td").each(function () {

                row.push($(this).text().replace(/,/g, " "));

            });

            csv.push(row.join(","));

        });

        var blob = new Blob(
            [csv.join("\r\n")],
            { type: "text/csv;charset=utf-8;" });

        var link = document.createElement("a");

        link.href = URL.createObjectURL(blob);

        link.download = "SocketHistory.csv";

        document.body.appendChild(link);

        link.click();

        document.body.removeChild(link);

    },

    autoScroll: function () {

        if (this.controls.request.length > 0)
            this.controls.request.scrollTop(this.controls.request[0].scrollHeight);

        if (this.controls.response.length > 0)
            this.controls.response.scrollTop(this.controls.response[0].scrollHeight);

    },

    htmlEncode: function (value) {

        if (value == null)
            return "";

        return $("<div/>").text(value).html();

    }

};

$(function () {

    SocketClient.init();

});
